---
import { img, Container } from "webto/variant";

interface Props {
  heading?: string;
  subheading?: string;
  products?: Array<{ title: string; price: string; image?: string; description?: string; url?: string }>;
}

const { heading, subheading, products = [] } = Astro.props;
---
<section class="bg-background py-16 sm:py-24">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="tracking-tight" style="font-family: var(--font-heading);"><span data-edit-field="heading">{heading}</span></h2>
      {subheading && <p data-edit-field="subheading" class="mt-3 text-muted-foreground">{subheading}</p>}
    </div>
    {products.length > 0 && (
      <ul class="mx-auto mt-12 grid max-w-4xl gap-x-12 gap-y-8 sm:grid-cols-2" data-wv-effect="stagger">
        {products.map((p, i) => (
          <li class="flex gap-4">
            {p.image && <img src={img(p.image, 240)} alt={p.title} data-edit-image={`products.${i}.image`} class="h-20 w-20 shrink-0 object-cover" style="border-radius: var(--radius);" />}
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline gap-3">
                <p data-edit-field={`products.${i}.title`} class="text-lg font-semibold text-foreground">{p.title}</p>
                <span aria-hidden="true" class="flex-1 border-b border-dotted border-border"></span>
                <span data-edit-field={`products.${i}.price`} class="shrink-0 font-semibold text-primary">{p.price}</span>
              </div>
              {p.description && <p data-edit-field={`products.${i}.description`} class="mt-1 text-sm text-muted-foreground">{p.description}</p>}
            </div>
          </li>
        ))}
      </ul>
    )}
  </Container>
</section>
